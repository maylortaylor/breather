#!/usr/bin/env bash
# Fail-closed secret scan on staged changes. Enabled by:
#   git config core.hooksPath .githooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not installed: brew install gitleaks" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --config .gitleaks.toml
